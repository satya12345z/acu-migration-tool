# Copy to .env and fill in. Never commit .env.

# Instance root, no trailing slash, e.g. https://yourcompany.acumatica.com
# (or https://server/AcumaticaERP for an on-prem install with a virtual directory)
ACUMATICA_BASE_URL=

# Optional. Defaults to ${ACUMATICA_BASE_URL}/identity/connect/token
ACUMATICA_TOKEN_URL=

# From Acumatica: Integration > Connected Applications (SM303010), flow "Resource Owner Password Credentials".
# Client ID looks like  GUID@TenantName  (copy it exactly, including @TenantName).
ACUMATICA_CLIENT_ID=
ACUMATICA_CLIENT_SECRET=

# A dedicated Acumatica API user with roles that can read the entities you call.
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=

# "api" is required; "offline_access" gives a refresh_token so the app doesn't re-login every hour.
ACUMATICA_SCOPE=api offline_access

# Web Service Endpoints (SM207060): endpoint name and version your instance exposes.
ACUMATICA_ENDPOINT=Default
ACUMATICA_ENDPOINT_VERSION=24.200.001

# Entity used by testConnection()
ACUMATICA_TEST_ENTITY=Customer
ACUMATICA_TIMEOUT_MS=60000

# Used by customTableController.js (via env-config) to AES-256-GCM encrypt saved secrets.
# Set a long random value and keep it stable, or previously saved connections can't be decrypted.
JWT_SECRET=
